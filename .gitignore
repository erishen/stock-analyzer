# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/
env/

# Environment variables
.env

# Output files - charts
output/charts/*.png

# Output files - reports
output/reports/*.json

# Output files - exports
output/exports/*.csv
output/exports/*.json

# Runtime state from local-only data tooling (gitignored data_tools/) — never committed
output/backfill_5y_state.json
output/bj_codes.txt

# Keep output directories
!output/.gitkeep
!output/charts/.gitkeep
!output/reports/.gitkeep
!output/exports/.gitkeep

# Database (runtime data)
*.db.backup_*
*.db-shm
*.db-wal
data/stock_analysis.db
data/*.demo_backup_*
data/stock_klines.db
data/stock_info_cache.json

# Runtime user data (privacy: LLM keys, paper-trading holdings, caches)
# These are generated locally and MUST NOT be committed - git add . would otherwise leak them
data/llm_settings.json
data/paper_portfolio.json
data/cache/
data/asset_snapshot.db

# Local-only data tooling (fetch/backfill/cron helpers) — NEVER pushed to GitHub
data_tools/

# Coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
!frontend/vite.config.ts
!frontend/postcss.config.js
!frontend/tailwind.config.js

# Web static: render.yaml buildCommand 会自动 build 覆盖; 此处保留 git 跟踪作为
# build 失败时的兜底, 避免线上回落到占位页。
# src/web/static/assets/
# src/web/static/index.html

# OS files
.DS_Store
Thumbs.db
*.log
fix_logger.py
fix_logger2.py
replace_print.py

.workbuddy/
