# ============================================
# Stock Analyzer 环境配置示例
# 复制为 .env 后按需修改; 读取逻辑见 libs/investkit_utils/src/investkit_utils/db/paths.py
# 相对路径相对于 investkit_utils 包根解析，建议使用绝对路径
# ============================================

# ---------- 数据库路径 ----------

# 分析数据库（ETL 输出，含 51 个技术指标）
STOCK_ANALYSIS_DB_PATH=/absolute/path/to/stock-analyzer/data/stock_analysis.db

# K 线数据库（AkShare fetch 的原始数据，ETL 输入，唯一数据源）
STOCK_KLINES_DB_PATH=/absolute/path/to/stock-analyzer/data/stock_klines.db

# 统一数据库目录（可选，设置后未单独指定的库都放在此目录下）
# INVESTKIT_DB_PATH=

# ---------- Web 服务 ----------

# 后端端口（默认 8001，避免与常用 8000 冲突）
# WEB_PORT=8001

# 前端 Vite 开发服务器端口（默认 3000）
# VITE_PORT=3000

# 数据更新功能开关（页面「拉取最新数据」/ POST /api/update、POST /api/asset/refresh 资产快照）。
# 对应 data_tools/ 与东财/腾讯行情抓取——该能力不随仓库分发，默认关闭。
# 仅在本机显式设为 1 时，Web 端才注册更新/抓取端点并展示对应入口。
# WEB_ENABLE_UPDATE=1

# K 线数据源选择（默认 tencent）:
#   tencent  : 腾讯源优先，失败降级东财（东财被 TLS 指纹拦截频繁，腾讯更快；默认）
#   eastmoney: 东财优先，失败降级腾讯，连续失败 10 次熔断（字段最全，含成交额/换手率）
#   auto     : 同 eastmoney（自适应）
# STOCK_FETCH_SOURCE=tencent

# 容器内拉取行情用的出网代理端口（Docker 直连腾讯/东财常被 TLS 拦截，走宿主代理即通）。
# 宿主运行（make daily-update）无需此配置；容器默认 7897（Clash 常见端口），无代理环境可置空。
# STOCK_PROXY_PORT=7897

# 钉钉群推送（data_tools/daily_update.py --notify / make push-report 使用）
# 自定义机器人 webhook 与「加签」密钥；不配置则跳过推送（更新本身不受影响）。
# STOCK_WEBHOOK_URL=
# STOCK_WEBHOOK_SECRET=

# 报告全文链接（可选）：配了公网可访问的 URL 后，钉钉消息末尾追加「查看完整报告」超链接。
# 本地文件/容器页面(127.0.0.1)无法被钉钉打开，必须有公网可达的地址才配置此项。
# STOCK_REPORT_URL=

# Agent 对话鉴权令牌（非本机访问 /api/agent/chat 需请求头 Authorization: Bearer <此令牌>）。
# 本机(127.0.0.1)访问免鉴权; 未配置此令牌时, 非本机访问一律拒绝(安全默认)。
# 建议用随机长串, 例: openssl rand -hex 24
# WEB_CHAT_TOKEN=

# ---------- 数据同步 ----------

# 从外部项目同步 .env 的源路径（make sync-env 使用）
# SYNC_ENV_SOURCE=/path/to/external/.env

# ---------- 可选: 外部数据源 API Key ----------
# 当前数据源为 AkShare（免费、无需 Key），以下为备用

# Alpha Vantage API: https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Finnhub API: https://finnhub.io/dashboard
# FINNHUB_API_KEY=

# ---------- 可选: AI 分析 / Agent 对话 ----------
# 供「🤖 AI 选股」Tab 的 Text2SQL 问答使用（OpenAI 兼容接口）。
# 配置优先级：本文件(.env) > invest-kit/work/harness/datapulse/.env > 进程环境变量
# 读取逻辑见 src/agent/llm.py

# LLM 服务基础地址（OpenAI 兼容 /v1 结尾）
# LLM_BASE_URL=https://api.openai.com/v1

# LLM API Key
# LLM_API_KEY=sk-xxxx

# LLM 模型名
# LLM_MODEL=gpt-4o-mini

# 兼容旧配置（未设置 LLM_* 时的回退项）
# DEEPSEEK_API_KEY=
# AI_MODEL=deepseek-chat
