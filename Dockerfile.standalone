# syntax=docker/dockerfile:1
# ============================================================
# Stock Analyzer — standalone 镜像（构建上下文 = 本仓库根目录）
#
#   docker build -f Dockerfile.standalone -t stock-analyzer:standalone .
#   docker compose -f docker-compose.standalone.yml up -d
#
# 与 monorepo 版 Dockerfile 的区别:
#   - 不依赖 ../.. 的 workspace（根 pyproject.toml / uv.lock / libs/），只用本仓库自己的
#     pyproject.toml + uv.lock → 单独克隆这个仓库也能构建
#   - 完全不 COPY data_tools/（该目录不入公开仓库）；缺模块时更新端点优雅降级
#   - 不含"拉取最新数据"能力（该能力依赖未分发的 data_tools）
# ============================================================

# ---------- Stage 1: 前端构建 ----------
FROM node:24-slim AS frontend

ARG PNPM_REGISTRY=https://registry.npmmirror.com

WORKDIR /build

COPY frontend/package.json frontend/pnpm-lock.yaml ./frontend/
RUN corepack enable \
    && cd frontend \
    && pnpm install --frozen-lockfile --registry=${PNPM_REGISTRY} --allow-build=esbuild

COPY frontend/ ./frontend/
RUN cd frontend && pnpm build

# ---------- Stage 2: Python 运行时 ----------
FROM python:3.13-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv \
    && mkdir -p /app/data /app/output /app/logs

WORKDIR /app

# 注意: 仓库根这份 uv.lock 是 monorepo workspace 的产物(依赖 investkit-utils、缺 web/ml
# extras), 单仓库直接 --frozen 会报 "Extra `ml` is not defined"; 这里按本仓库 pyproject
# 现场解析并生成容器内 lock，保证独立构建可用（代价是首次构建略慢）。
COPY pyproject.toml ./
COPY src/ ./src/
COPY investkit_utils/ ./investkit_utils/
COPY scripts/ ./scripts/

# PyPI 默认源在部分网络下会卡住; 与前端一样默认走国内镜像, 可用 --build-arg 覆盖
ARG UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN uv sync --extra web --extra ml --no-dev --no-cache --index-url ${UV_INDEX_URL}

COPY --from=frontend /build/src/web/static ./src/web/static

# 运行时不再走 `uv run`(启动时它还会去 PyPI 解析 build-system.requires, 离线/被墙环境直接起不来);
# 直接用 venv 里的入口 + 把 src 放到 sys.path, 解决代码里的裸导入(from data/web/agent/config…)
ENV PYTHONPATH=/app/src \
    UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8001/api/enabled',timeout=5)"

CMD [".venv/bin/stock-analyzer", "web", "--host", "0.0.0.0", "--port", "8001"]
